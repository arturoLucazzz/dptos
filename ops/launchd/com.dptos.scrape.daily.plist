<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily scrape at 03:00 local time.

  Install:
    cp ops/launchd/com.dptos.scrape.daily.plist ~/Library/LaunchAgents/
    # Edit WorkingDirectory and the script path to match this checkout, then:
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.dptos.scrape.daily.plist

  Pause without uninstalling: SCRAPER_ENABLED=false in .env
  Unload: launchctl bootout gui/$(id -u)/com.dptos.scrape.daily
  Kick now: launchctl kickstart -k gui/$(id -u)/com.dptos.scrape.daily
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.dptos.scrape.daily</string>

    <key>WorkingDirectory</key>
    <string>/Users/arturoLucazzz/Code/dptos</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>/Users/arturoLucazzz/Code/dptos/scripts/scrape-wrapper.sh</string>
      <string>daily</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>3</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>

    <!-- launchd's own streams; the wrapper also appends to ~/Library/Logs/dptos/. -->
    <key>StandardOutPath</key>
    <string>/Users/arturoLucazzz/Library/Logs/dptos/launchd-daily.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/arturoLucazzz/Library/Logs/dptos/launchd-daily.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
      <key>HOME</key>
      <string>/Users/arturoLucazzz</string>
    </dict>
  </dict>
</plist>
