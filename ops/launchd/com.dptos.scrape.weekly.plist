<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Full-Lima scrape every Saturday at 03:30. Five to seven hours; feeds district
  medians and the construction pipeline.

  Install alongside the daily job (same WorkingDirectory edit if the checkout moves).
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.dptos.scrape.weekly</string>

    <key>WorkingDirectory</key>
    <string>/Users/arturoLucazzz/Code/dptos</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>/Users/arturoLucazzz/Code/dptos/scripts/scrape-wrapper.sh</string>
      <string>weekly</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
      <key>Weekday</key>
      <integer>6</integer>
      <key>Hour</key>
      <integer>3</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/arturoLucazzz/Library/Logs/dptos/launchd-weekly.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/arturoLucazzz/Library/Logs/dptos/launchd-weekly.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
      <key>HOME</key>
      <string>/Users/arturoLucazzz</string>
    </dict>
  </dict>
</plist>
