{
  "name": "dptos",
  "version": "1.0.0",
  "description": "Real estate scraping + Next.js app",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.scraper.json && next build",
    "dev": "next dev",
    "scrape": "tsx --env-file-if-exists=.env scraper/src/index.ts scrape",
    "scrape:probe": "tsx --env-file-if-exists=.env scraper/src/probe.ts",
    "process": "tsx --env-file-if-exists=.env scraper/src/index.ts process",
    "replay": "tsx --env-file-if-exists=.env scraper/src/replay.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:seed:market": "tsx --env-file-if-exists=.env prisma/seed-market.ts",
    "scrape:daily": "bash scripts/scrape-wrapper.sh daily",
    "scrape:weekly": "bash scripts/scrape-wrapper.sh weekly",
    "ops:install-launchd": "bash ops/launchd/install.sh",
    "build:scraper": "tsc -p tsconfig.scraper.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scraper/tsconfig.json && tsc --noEmit -p tsconfig.scraper.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --import tsx --test \"lib/**/*.test.ts\" \"scraper/**/*.test.ts\"",
    "start": "next start"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@tanstack/react-table": "^8.21.3",
    "async-retry": "^1.3.3",
    "axios": "^1.6.5",
    "cheerio": "^1.0.0-rc.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "nuqs": "^2.9.4",
    "playwright": "^1.49.0",
    "puppeteer": "^23.0.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/async-retry": "^1.4.9",
    "@types/node": "20.19.30",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.1.6",
    "prisma": "^7.9.0",
    "tailwindcss": "4.1.18",
    "tsx": "^4.7.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  }
}
