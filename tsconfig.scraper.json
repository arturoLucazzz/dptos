{
  // Build/emit entry. The IDE picks up scraper/tsconfig.json when editing files
  // under scraper/; this file is what `pnpm typecheck` / `pnpm build:scraper` run.
  "extends": "./scraper/tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": ["scraper/src/**/*", "lib/**/*", "prisma/**/*.ts"],
  "exclude": ["node_modules", "dist", "lib/generated/**", "lib/utils.ts"]
}
