# Copy to .env and fill in.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dptos"

# Kill switch. false = pnpm scrape:daily and pnpm scrape:weekly exit without scraping.
SCRAPER_ENABLED=true

# Daily districts (comma-separated). Weekly ignores this and does all of Lima.
# SCRAPER_DAILY_DISTRICTS=lince,jesus-maria,san-miguel,surquillo,magdalena,pueblo-libre,san-isidro,miraflores,barranco,santiago-de-surco,san-borja

# Browser: Urbania returns 403 to headless Chromium.
# SCRAPER_HEADLESS=0
# SCRAPER_ENGINE=playwright
# PLAYWRIGHT_CHANNEL=chrome
