# Copy to .env and fill in.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dptos"

# Kill switch for launchd jobs. false = wrapper exits without scraping.
SCRAPER_ENABLED=true

# Daily districts (comma-separated). Weekly ignores this and does all of Lima.
# SCRAPER_DAILY_DISTRICTS=lince,jesus-maria,san-miguel,surquillo,magdalena-del-mar,pueblo-libre,san-isidro,miraflores,barranco,santiago-de-surco

# Hours without a successful run before a catch-up is considered stale.
# SCRAPER_STALE_HOURS=20

# Pull before each scheduled run (never mid-run). Set 0 on a machine that should not pull.
# SCRAPER_GIT_PULL=1

# Browser: Urbania returns 403 to headless Chromium.
# SCRAPER_HEADLESS=0
# SCRAPER_ENGINE=playwright
# PLAYWRIGHT_CHANNEL=chrome
